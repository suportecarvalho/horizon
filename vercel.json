{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/carrinho",
      "destination": "/checkout/index.html"
    },
    {
      "source": "/cart",
      "destination": "/checkout/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout/index.html"
    },
    {
      "source": "/leaderboards/:steamid",
      "destination": "/leaderboards/player"
    },
    {
      "source": "/leaderboards/player",
      "destination": "/leaderboards/player.html"
    },
    {
      "source": "/feed",
      "destination": "/feed/index.html"
    },
    {
      "source": "/api/checkout/:action",
      "destination": "/api/checkout?action=:action"
    },
    {
      "source": "/api/vip/:action",
      "destination": "/api/vip?action=:action"
    },
    {
      "source": "/auth/steam/return",
      "destination": "/api/auth?action=return"
    },
    {
      "source": "/api/auth/steam/return",
      "destination": "/api/auth?action=return"
    },
    {
      "source": "/auth/:action",
      "destination": "/api/auth?action=:action"
    },
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth?action=:action"
    },
    {
      "source": "/_next/static/css/:file*",
      "destination": "/css/:file*"
    },
    {
      "source": "/_next/static/media/:file*",
      "destination": "/fonts/:file*"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Bypass-Tunnel-Reminder, X-API-KEY"
        }
      ]
    },
    {
      "source": "/css/horizon-custom.css",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "video/mp4"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
